// prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
   engineType = "library"
}

enum DocumentKind {
  TAILORED_RESUME
  CREATED_RESUME
  COVER_LETTER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELED
  BONUS
}

enum MarketCode {
  ZW
  ZA
}

enum PurchaseType {
  RESUME_DOWNLOAD_UNLOCK
  SYSTEM_BONUS
}

enum SubscriptionTier {
  STARTER
  PRO
  PLUS
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String?   @unique
  passwordHash       String?
  emailVerified      DateTime?
  image              String?
  onboardingComplete Boolean   @default(false)

  // Consent tracking (POPIA / data protection compliance)
  consentGiven    Boolean   @default(false)
  consentGivenAt  DateTime?
  consentVersion  String?   // e.g. "ZA-2026-v1" or "ZW-2026-v1"

  // Admin flag
  isAdmin           Boolean   @default(false)

  // Email broadcast preferences
  marketingOptOut Boolean @default(false)

  // relations
  sessions      Session[]
  documents     Document[]
  purchases     Purchase[]
  verifications EmailVerification[]
  resets        PasswordReset[]
  oauthAccounts OAuthAccount[]
  profile       Profile?
  subscription  Subscription?
  usageRecords  SubscriptionUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  // basics
  headline        String? // e.g., "Software Developer"
  location        String?
  phone           String?
  website         String?
  linkedInUrl     String?
  // education
  school          String?
  degree          String?
  graduationYear  String?
  // skills & prefs
  skills          Json? // string[]
  targetRoles     String?
  targetLocations String?
  jobType         String? // "Full-time" | "Part-time" | ...

  // Last used resume
  resumeMarkdown      String?
  resumeFileName      String?
  resumeUpdatedAt     DateTime?


  // metadata
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique // opaque session token
  expires   DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expires])
}

model Document {
  id                String      @id @default(cuid())
  userId            String
  kind              DocumentKind
  title             String      @default("")
  markdown          String // full content
  sections          Json // parsed sections for editor/preview
  sourceMeta        Json? // snapshot of jd/resume/env
  market            MarketCode  @default(ZW)
  downloadPriceMinor Int?
  downloadCurrency  String?
  unlockedAt        DateTime?
  unlockPurchaseId  String?     @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User      @relation(fields: [userId], references: [id])
  purchases      Purchase[] @relation("PurchaseTargetDocument")
  unlockPurchase Purchase?  @relation("DocumentUnlockPurchase", fields: [unlockPurchaseId], references: [id])

  @@index([userId, kind, createdAt])
  @@index([market])
}

model Purchase {
  id          String        @id @default(cuid())
  userId      String
  provider    String        @default("PESEPAY") // keep simple, future providers optional
  type        PurchaseType  @default(RESUME_DOWNLOAD_UNLOCK)
  market      MarketCode    @default(ZW)
  amount      Int // minor units (e.g., cents)
  currency    String        @default("USD")
  status      PaymentStatus @default(PENDING)
  providerRef String?       @unique // e.g., pesepay reference/transaction id
  documentId  String?
  fulfilledAt DateTime?
  meta        Json? // raw payloads / fields from provider

  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  document  Document? @relation("PurchaseTargetDocument", fields: [documentId], references: [id])
  unlockedDocument Document? @relation("DocumentUnlockPurchase")

  @@index([userId, createdAt])
  @@index([status])
  @@index([market, type, createdAt])
  @@index([documentId])
}

/**
 * Email verification flow (code-based or link-based) *
 */
model EmailVerification {
  id         String    @id @default(cuid())
  userId     String
  email      String
  // Either store a 6-digit code (hashed) or a random token (hashed). We’ll use codeHash for MVP.
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
  @@index([email])
}

/**
 * Password reset via token (optional but handy) *
 */
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
}

/**
 * Optional future: OAuth accounts (keeps door open for Google later) *
 */
model OAuthAccount {
  id                String @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String

  accessToken  String?
  refreshToken String?
  expiresAt    Int?

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Subscription {
  id                       String             @id @default(cuid())
  userId                   String             @unique
  tier                     SubscriptionTier
  status                   SubscriptionStatus
  billingCycle             BillingCycle
  market                   MarketCode

  trialEndsAt              DateTime?
  currentPeriodStart       DateTime
  currentPeriodEnd         DateTime
  cancelAtPeriodEnd        Boolean            @default(false)
  canceledAt               DateTime?

  // Paystack (ZA auto-renewal)
  paystackCustomerCode     String?
  paystackSubscriptionCode String?
  paystackAuthCode         String?
  paystackPlanCode         String?
  paystackEmailToken       String?

  // Pesepay (ZW manual renewal)
  lastPesepayRef           String?

  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([currentPeriodEnd])
}

enum BriefingSource {
  REDDIT
  QUORA
  LINKEDIN
  NEWSLETTER
  ARTICLE
}

enum BriefingStatus {
  PUBLISHED
  HIDDEN
}

model BriefingItem {
  id           String         @id @default(cuid())
  source       BriefingSource
  sourceDetail String
  category     String
  title        String
  summary      String         @db.Text
  image        String?
  readTime     String
  stat         String?
  url          String         @unique
  featured     Boolean        @default(false)
  status       BriefingStatus @default(PUBLISHED)
  publishedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, featured, createdAt])
  @@index([category])
}

enum IngestTrigger {
  MANUAL
  CRON
}

enum IngestStatus {
  RUNNING
  SUCCESS
  FAILED
}

model IngestRun {
  id           String        @id @default(cuid())
  trigger      IngestTrigger
  status       IngestStatus  @default(RUNNING)
  saved        Int           @default(0)
  skipped      Int           @default(0)
  errors       Int           @default(0)
  errorMessage String?
  startedAt    DateTime      @default(now())
  finishedAt   DateTime?

  @@index([startedAt])
}

enum BroadcastStatus {
  SENDING
  COMPLETED
  FAILED
}

model EmailBroadcast {
  id             String          @id @default(cuid())
  subject        String
  body           String          @db.Text
  audienceFilter Json
  recipientCount Int             @default(0)
  sentCount      Int             @default(0)
  failedCount    Int             @default(0)
  status         BroadcastStatus @default(SENDING)
  sentByEmail    String
  createdAt      DateTime        @default(now())
  completedAt    DateTime?

  @@index([createdAt])
}

model SubscriptionUsage {
  id               String   @id @default(cuid())
  userId           String
  periodStart      DateTime
  tailorCount      Int      @default(0)
  downloadCount    Int      @default(0)
  coverLetterCount Int      @default(0)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, periodStart])
  @@index([userId, periodStart])
}

