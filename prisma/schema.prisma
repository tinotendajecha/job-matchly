// prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
   engineType = "library"
}

enum DocumentKind {
  TAILORED_RESUME
  CREATED_RESUME
  COVER_LETTER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELED
  BONUS
}

enum MarketCode {
  ZW
  ZA
}

enum PurchaseType {
  RESUME_DOWNLOAD_UNLOCK
  SYSTEM_BONUS
}

enum SubscriptionTier {
  STARTER
  PRO
  PLUS
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String?   @unique
  passwordHash       String?
  emailVerified      DateTime?
  image              String?
  onboardingComplete Boolean   @default(false)

  // Consent tracking (POPIA / data protection compliance)
  consentGiven    Boolean   @default(false)
  consentGivenAt  DateTime?
  consentVersion  String?   // e.g. "ZA-2026-v1" or "ZW-2026-v1"

  /// Set when the person deletes their account. The row survives because
  /// Purchase and Subscription reference it and financial records must be kept
  /// for tax purposes; everything identifying is scrubbed at the same time, so
  /// what remains is an anonymous stub, not an account.
  deletedAt         DateTime?

  /// Lifetime count of tailors run without a paid subscription.
  ///
  /// Deliberately not a period counter like SubscriptionUsage: the free
  /// allowance is once ever, not once a month, so it must not reset. Claimed
  /// atomically before the model call so two concurrent requests can't both
  /// spend the last one.
  freeTailorsUsed   Int       @default(0)

  // Admin flag
  isAdmin           Boolean   @default(false)

  // Email preferences. Deliberately separate: someone who mutes announcements
  // may still want job alerts, and conflating them loses that distinction.
  marketingOptOut Boolean @default(false)
  jobAlertsOptOut Boolean @default(false)
  lastJobDigestAt DateTime?

  // Discoverability by recruiters. Defaults to false and only ever becomes true
  // through an affirmative action by the user — never by signup, import, or
  // inference. This is the operational read; ConsentRecord is the audit trail,
  // and the two are always written together.
  recruiterVisible   Boolean   @default(false)
  recruiterVisibleAt DateTime?

  // relations
  sessions      Session[]
  documents     Document[]
  purchases     Purchase[]
  verifications EmailVerification[]
  resets        PasswordReset[]
  oauthAccounts OAuthAccount[]
  profile       Profile?
  subscription  Subscription?
  usageRecords  SubscriptionUsage[]
  profession    UserProfession?
  jobMatches    JobMatch[]
  consents      ConsentRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  // basics
  headline        String? // e.g., "Software Developer"
  location        String?
  phone           String?
  website         String?
  linkedInUrl     String?
  // education
  school          String?
  degree          String?
  graduationYear  String?
  // skills & prefs
  skills          Json? // string[]
  targetRoles     String?
  targetLocations String?
  jobType         String? // "Full-time" | "Part-time" | ...

  // Last used resume
  resumeMarkdown      String?
  resumeFileName      String?
  resumeUpdatedAt     DateTime?


  // metadata
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique // opaque session token
  expires   DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expires])
}

model Document {
  id                String      @id @default(cuid())
  userId            String
  kind              DocumentKind
  title             String      @default("")
  markdown          String // full content
  sections          Json // parsed sections for editor/preview
  sourceMeta        Json? // snapshot of jd/resume/env
  market            MarketCode  @default(ZW)
  downloadPriceMinor Int?
  downloadCurrency  String?
  unlockedAt        DateTime?
  unlockPurchaseId  String?     @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User      @relation(fields: [userId], references: [id])
  purchases      Purchase[] @relation("PurchaseTargetDocument")
  unlockPurchase Purchase?  @relation("DocumentUnlockPurchase", fields: [unlockPurchaseId], references: [id])

  @@index([userId, kind, createdAt])
  @@index([market])
}

model Purchase {
  id          String        @id @default(cuid())
  userId      String
  provider    String        @default("PESEPAY") // keep simple, future providers optional
  type        PurchaseType  @default(RESUME_DOWNLOAD_UNLOCK)
  market      MarketCode    @default(ZW)
  amount      Int // minor units (e.g., cents)
  currency    String        @default("USD")
  status      PaymentStatus @default(PENDING)
  providerRef String?       @unique // e.g., pesepay reference/transaction id
  documentId  String?
  fulfilledAt DateTime?
  meta        Json? // raw payloads / fields from provider

  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  document  Document? @relation("PurchaseTargetDocument", fields: [documentId], references: [id])
  unlockedDocument Document? @relation("DocumentUnlockPurchase")

  @@index([userId, createdAt])
  @@index([status])
  @@index([market, type, createdAt])
  @@index([documentId])
}

/**
 * Email verification flow (code-based or link-based) *
 */
model EmailVerification {
  id         String    @id @default(cuid())
  userId     String
  email      String
  // Either store a 6-digit code (hashed) or a random token (hashed). We’ll use codeHash for MVP.
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
  @@index([email])
}

/**
 * Password reset via token (optional but handy) *
 */
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  /// Issue time. Rate limiting needs to count requests in a window, and
  /// expiresAt can't stand in for it: issuing a new link marks the old one
  /// used but leaves it unexpired, so counting by expiry conflates links that
  /// were consumed with links that are still outstanding.
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
  @@index([userId, createdAt])
}

/**
 * Optional future: OAuth accounts (keeps door open for Google later) *
 */
model OAuthAccount {
  id                String @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String

  accessToken  String?
  refreshToken String?
  expiresAt    Int?

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Subscription {
  id                       String             @id @default(cuid())
  userId                   String             @unique
  tier                     SubscriptionTier
  status                   SubscriptionStatus
  billingCycle             BillingCycle
  market                   MarketCode

  trialEndsAt              DateTime?
  currentPeriodStart       DateTime
  currentPeriodEnd         DateTime
  cancelAtPeriodEnd        Boolean            @default(false)
  canceledAt               DateTime?

  // Paystack (ZA auto-renewal)
  paystackCustomerCode     String?
  paystackSubscriptionCode String?
  paystackAuthCode         String?
  paystackPlanCode         String?
  paystackEmailToken       String?

  // Pesepay (ZW manual renewal)
  lastPesepayRef           String?

  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([currentPeriodEnd])
}

enum BriefingSource {
  REDDIT
  QUORA
  LINKEDIN
  NEWSLETTER
  ARTICLE
}

enum BriefingStatus {
  PUBLISHED
  HIDDEN
}

model BriefingItem {
  id           String         @id @default(cuid())
  source       BriefingSource
  sourceDetail String
  category     String
  title        String
  summary      String         @db.Text
  image        String?
  readTime     String
  stat         String?
  url          String         @unique
  featured     Boolean        @default(false)
  status       BriefingStatus @default(PUBLISHED)
  publishedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, featured, createdAt])
  @@index([category])
}

enum IngestTrigger {
  MANUAL
  CRON
}

enum IngestStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum IngestKind {
  BRIEFING
  JOBS
  TAGGING
}

model IngestRun {
  id           String        @id @default(cuid())
  kind         IngestKind    @default(BRIEFING)
  trigger      IngestTrigger
  status       IngestStatus  @default(RUNNING)
  saved        Int           @default(0)
  skipped      Int           @default(0)
  errors       Int           @default(0)
  errorMessage String?
  /// What this run actually covered: sources attempted, categories reached or
  /// failed, API calls spent, listings observed. Without it a later query can't
  /// tell a real change in the market from a change in our own crawl — adding
  /// categories or losing a source to rate limiting both look like hiring moves.
  meta         Json?
  startedAt    DateTime      @default(now())
  finishedAt   DateTime?

  @@index([startedAt])
}

enum BroadcastStatus {
  SENDING
  COMPLETED
  FAILED
}

model EmailBroadcast {
  id             String          @id @default(cuid())
  subject        String
  body           String          @db.Text
  audienceFilter Json
  recipientCount Int             @default(0)
  sentCount      Int             @default(0)
  failedCount    Int             @default(0)
  status         BroadcastStatus @default(SENDING)
  style          String          @default("PERSONAL") // PERSONAL | BRANDED
  sentByEmail    String
  createdAt      DateTime        @default(now())
  completedAt    DateTime?

  deliveries EmailDelivery[]

  @@index([createdAt])
}

/// One row per recipient, so "did it actually send" is answerable per person
/// rather than inferred from an HTTP status code.
model EmailDelivery {
  id          String   @id @default(cuid())
  broadcastId String
  email       String
  userId      String?
  resendId    String?
  accepted    Boolean  @default(false)
  lastEvent   String? // raw Resend event: delivered / bounced / complained / ...
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  broadcast EmailBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@index([broadcastId])
  @@index([createdAt]) // admin error feed orders by this across all deliveries
}

enum JobSource {
  VACANCYMAIL
  ADZUNA
  IHARAREJOBS
}

/// One outbound click on a shared job link, so we can tell whether sharing
/// actually brings people in and which jobs travel.
model JobShareEvent {
  id     String @id @default(cuid())
  jobId  String
  /// SHARED when someone copies or sends the link, VIEWED when the public page
  /// is opened, SIGNUP when a visit leads to a new account.
  kind   String
  /// Set only where we know it: the sharer for SHARED, the new account for SIGNUP.
  userId String?
  /// The jm_vid cookie. Lets a repeat reader be counted once, and links a view
  /// to the signup that followed it.
  visitorId String? @db.VarChar(36)
  /// Referring host, or null for direct. Messaging apps usually send no
  /// referrer, so this mainly separates search traffic — these pages are
  /// indexable, and a view is not evidence of a share on its own.
  referrerHost String? @db.VarChar(128)
  createdAt DateTime @default(now())

  job JobPost @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, kind])
  @@index([kind, createdAt])
  @@index([visitorId])
}

enum ConsentPurpose {
  /// The signup Data Protection & Consent Agreement.
  ACCOUNT_TERMS
  /// Being discoverable by, and contactable through, verified recruiters.
  RECRUITER_VISIBILITY
  /// Electronic direct marketing (POPIA s69).
  MARKETING_EMAIL
  /// Job alert digests.
  JOB_ALERTS
}

/// Append-only consent log.
///
/// A boolean on User records what someone agreed to; it cannot show that they
/// agreed on a date, under a specific policy version, and later withdrew. POPIA
/// requires the latter, so nothing here is ever updated or deleted — a
/// withdrawal is a new row with granted = false. Rows go when the account does.
model ConsentRecord {
  id        String         @id @default(cuid())
  userId    String
  purpose   ConsentPurpose
  granted   Boolean
  /// Policy version the user was shown at the moment they acted.
  version   String
  /// Where the action happened: signup, profile, unsubscribe-link, campaign.
  source    String?
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@index([purpose, granted, createdAt])
}

enum JobStatus {
  ACTIVE
  EXPIRED
  /// Kept indefinitely for market-history analysis; never shown to job seekers.
  ARCHIVED
  HIDDEN
}

model JobPost {
  id             String     @id @default(cuid())
  source         JobSource
  sourceRef      String // stable id from the source
  url            String     @unique
  title          String
  company        String?
  companyLogo    String?
  location       String?
  market         MarketCode
  employmentType String?
  salaryText     String?
  description    String     @db.Text
  /// Profession bracket, taken from the source's own taxonomy — no AI involved.
  bracket        String?
  sourceCategory String? // raw category as the source labelled it
  seniority      String? // INTERN | GRADUATE | JUNIOR | MID | SENIOR | LEAD
  skills         Json? // string[]
  postedAt       DateTime?
  expiresAt      DateTime?
  status         JobStatus  @default(ACTIVE)
  /// When the listing actually left the market, set once on the ACTIVE -> EXPIRED
  /// transition. Distinct from updatedAt, which any later write would overwrite —
  /// this is the field that makes time-on-market computable after the fact.
  closedAt       DateTime?
  /// Last crawl in which this listing was still present on its source.
  ///
  /// Our expiry is date-driven: an undated listing is aged out at
  /// UNDATED_JOB_MAX_AGE_DAYS whether or not it is still advertised, so closedAt
  /// for those rows records our policy rather than the market. lastSeenAt is the
  /// observation — when it stops advancing, the source really did drop the
  /// listing. Only interpretable against the run's coverage: a listing can also
  /// go unseen because we never crawled its category that run.
  lastSeenAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matches JobMatch[]
  shares  JobShareEvent[]

  @@unique([source, sourceRef])
  @@index([market, status, postedAt])
  @@index([bracket])
  @@index([status, closedAt])
  @@index([status, lastSeenAt])
}

/// What we believe a user does, and — importantly — what that was inferred from.
model UserProfession {
  id          String   @id @default(cuid())
  userId      String   @unique
  bracket     String
  primaryRole String?
  seniority   String?
  skills      Json?
  locations   Json?
  confidence  Float    @default(0)
  method      String   @default("RULES") // RULES | AI — keeps AI spend auditable
  evidence    String?  @db.Text // the text that produced this tag
  derivedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JobMatch {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  score     Float
  reasons   Json?
  createdAt DateTime @default(now())

  job  JobPost @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, score])
}

enum DeviceType {
  DESKTOP
  MOBILE
  TABLET
  UNKNOWN
}

/// Anonymous page-view telemetry. Deliberately holds NO IP address and NO
/// userId, so a row is not linkable to an identified person — which is what
/// lets the write endpoint stay unauthenticated. Pruned to 90 days.
model PageView {
  id           String      @id @default(cuid())
  visitorId    String      @db.VarChar(36) // random uuid from the httpOnly jm_vid cookie
  sessionId    String?     @db.VarChar(36) // reserved: pages/session + bounce rate, no future migration
  path         String      @db.VarChar(512) // normalized: query stripped, ids collapsed to [id]
  referrerHost String?     @db.VarChar(128) // host only; null = direct or internal
  device       DeviceType  @default(UNKNOWN)
  country      String?     @db.VarChar(2) // from x-vercel-ip-country
  market       MarketCode?
  dayKey       String      @db.VarChar(10) // "YYYY-MM-DD" UTC — precomputed group key
  createdAt    DateTime    @default(now())

  @@index([createdAt])
}

model SubscriptionUsage {
  id               String   @id @default(cuid())
  userId           String
  periodStart      DateTime
  tailorCount      Int      @default(0)
  downloadCount    Int      @default(0)
  coverLetterCount Int      @default(0)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, periodStart])
  @@index([userId, periodStart])
}

